{
  "openapi": "3.0.0",
  "info": {
    "title": "Slack Webhook API",
    "description": "Send notifications to the store's Slack channel",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://hooks.slack.com",
      "description": "Slack API"
    }
  ],
  "paths": {
    "/services/T0BHPPDUVR7/B0BHKTT7TPY/1GOWQJCstYnavMf4XhvYqv4P": {
      "post": {
        "operationId": "send_slack_notification",
        "summary": "Send a notification to the inventory alerts Slack channel",
        "description": "Sends a message to the #all-inventory-agent-alerts channel. Use this after an order is approved or when important inventory events occur.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "The message to send to the Slack channel"
                  }
                }
              }
            }
          }
        },
        "responses": {
  "200": {
    "description": "Message sent successfully",
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "example": "ok"
            }
          }
        }
      }
    }
  }
}
      }
    }
  }
}